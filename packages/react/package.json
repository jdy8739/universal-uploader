{
  "name": "@universal-uploader/react",
  "version": "1.2.1",
  "type": "module",
  "description": "React hook for streaming file uploads with progress tracking, retries, pause/resume, and fetch/XHR fallback powered by @universal-uploader/core.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.2.6"
  },
  "dependencies": {
    "@universal-uploader/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdy8739/universal-uploader.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "react-hook",
    "hooks",
    "file-upload",
    "upload",
    "streaming",
    "progress",
    "fetch",
