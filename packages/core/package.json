{
  "name": "@universal-uploader/core",
  "version": "1.1.2",
  "type": "module",
  "description": "Zero-dependency browser file upload library with Web Streams, Fetch Duplex, XHR fallback, progress tracking, chunked uploads, and automatic retries.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdy8739/universal-uploader.git",
    "directory": "packages/core"
  },
  "keywords": [
    "upload",
    "file-upload",
    "streaming",
    "web-streams",
    "fetch",
    "xhr",
    "progress",
    "chunked-upload",
    "multipart",
    "large-files",
    "browser",
    "duplex",
    "retry",
    "resumable",
    "universal-uploader"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitest/ui": "^4.1.9",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.9"
  }
}
