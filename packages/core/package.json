{
  "name": "@universal-uploader/core",
  "version": "1.1.3",
  "type": "module",
  "description": "Zero-dependency browser file upload library with Web Streams, Fetch Duplex, XHR fallback, progress tracking, chunked uploads, and automatic retries.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js",
      "require": "./dist/base.cjs"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js",
      "require": "./dist/auto.cjs"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js",
      "require": "./dist/stream.cjs"
    },
    "./stream-chunked": {
      "types": "./dist/stream-chunked.d.ts",
      "import": "./dist/stream-chunked.js",
      "require": "./dist/stream-chunked.cjs"
    },
    "./xhr-chunked": {
      "types": "./dist/xhr-chunked.d.ts",
      "import": "./dist/xhr-chunked.js",
      "require": "./dist/xhr-chunked.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdy8739/universal-uploader.git",
    "directory": "packages/core"
  },
  "keywords": [
    "upload",
    "file-upload",
    "streaming",
    "web-streams",
    "fetch",
    "xhr",
    "progress",
    "chunked-upload",
    "multipart",
    "large-files",
    "browser",
    "duplex",
    "retry",
    "resumable",
    "universal-uploader"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitest/ui": "^4.1.9",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.9"
  }
}
